# Windows-specific justfile for LithicRivers
# Focused on core build and run functionality

# Set shell to use PowerShell
set shell := ["powershell.exe", "-NoProfile", "-Command"]

# Default toolchain (can be overridden)
toolchain := "stable"

# CPU count (PowerShell environment reference)
cpu_count := "$env:NUMBER_OF_PROCESSORS"

git-data:
    git describe --tags --abbrev=0 > VERSION
    git rev-parse HEAD > GIT_SHA
    git rev-parse --abbrev-ref HEAD > GIT_BRANCH

copy-config-data:
    cp -Force STEAM_APP_ID crates/client/assets/config/STEAM_APP_ID
    cp -Force VERSION crates/client/assets/config/VERSION
    cp -Force GIT_SHA crates/client/assets/config/GIT_SHA
    cp -Force GIT_BRANCH crates/client/assets/config/GIT_BRANCH
    cp -Force LICENSE crates/client/assets/config/LICENSE
    cp -Force THIRD-PARTY-NOTICES.txt crates/client/assets/config/THIRD-PARTY-NOTICES.txt

# Build in debug mode (default)
build: git-data copy-config-data
    cargo build --workspace -j {{cpu_count}}

stage-artifacts: build build-demos
    powershell.exe scripts/stage-artifacts.ps1

build-release: git-data copy-config-data
    cargo build --workspace --release -j {{cpu_count}}

stage-artifacts-release: build-release build-demos-release
    powershell.exe scripts/stage-artifacts-release.ps1

build-demos:
    cargo build -p lithicrivers-client --bin demo_inventory
    cargo build -p lithicrivers-client --bin demo_body
    cargo build -p lithicrivers-client --bin beezzaroll_color_test
    cargo build -p lithicrivers-client --bin beezzaroll_sprite_test
    cargo build -p lithicrivers-client --bin portrait_sprite_test

build-demos-release:
    cargo build -p lithicrivers-client --bin demo_inventory --release
    cargo build -p lithicrivers-client --bin demo_body --release
    cargo build -p lithicrivers-client --bin beezzaroll_color_test --release
    cargo build -p lithicrivers-client --bin beezzaroll_sprite_test --release
    cargo build -p lithicrivers-client --bin portrait_sprite_test --release

# Run debug build
run:
    cargo run -p lithicrivers-client --bin lithicrivers-client -j {{cpu_count}}

# Run release build
run-release:
    cargo run --release -p lithicrivers-client --bin lithicrivers-client -j {{cpu_count}}

# Run tests
test:
    cargo test --workspace -j {{cpu_count}}

# Clean build artifacts
clean:
    cargo clean

# Install Rust toolchain
install:
    rustup toolchain install stable
    rustup default stable
    rustup target add wasm32-unknown-unknown