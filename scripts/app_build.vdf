// SteamPipe App Build configuration
// Replace placeholders with your real AppID and DepotIDs from Steamworks.

"AppBuild"
{
    // REQUIRED: Your Steam App ID (e.g., 1234560). Do NOT quote with variables.
    "AppID"            "STEAM_APP_ID"

    // Human-readable description shown in SteamPipe build logs
    "Desc"             "CI build from GitHub Actions"

    // Where intermediate build output/logs go (relative to repo root)
    "BuildOutput"      "scripts/steampipe_out"

    // Root folder for all depot file mappings. We stage binaries into artifacts/
    "ContentRoot"      "."

    // Branch to set live automatically after upload. Use a beta branch name or "public"
    "SetLive"          "public"

    // Map each DepotID to its depot build script
    "Depots"
    {
        // Windows depot
        "YOUR_DEPOT_ID_WINDOWS"   "scripts/depot_build_windows.vdf"

        // Linux depot
        "YOUR_DEPOT_ID_LINUX"     "scripts/depot_build_linux.vdf"

        // macOS depot
        "YOUR_DEPOT_ID_MACOS"     "scripts/depot_build_macos.vdf"
    }
}