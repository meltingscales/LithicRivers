// Linux depot build configuration
// Replace DepotID with your real Linux depot ID

"DepotBuild"
{
    "DepotID"       "3940723"

    // Content root is inherited from AppBuild's ContentRoot (.)
    // Map all files in artifacts/ to the depot root
    "FileMapping"
    {
        "LocalPath"   "../artifacts/*"
        "DepotPath"   "."
        "Recursive"   "1"
    }
}
