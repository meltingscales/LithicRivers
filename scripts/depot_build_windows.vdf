// Windows depot build configuration
// Replace DepotID with your real Windows depot ID

"DepotBuild"
{
    "DepotID"       "3940721"

    // Content root is inherited from AppBuild's ContentRoot (.)
    // Map all files in artifacts/ to the depot root
    "FileMapping"
    {
        "LocalPath"   "..\\artifacts\\*"
        "DepotPath"   "."
        "Recursive"   "1"
    }
}
